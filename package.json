{
  "name": "storage-agent",
  "productName": "Storage Agent",
  "version": "37.0.0",
  "description": "A local agent for object storage",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "eval": "node scripts/eval.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:audit": "node scripts/e2e-audit.mjs",
    "budget": "node scripts/budget.mjs",
    "contrast": "node scripts/contrast.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format=cyclonedx > sbom.json",
    "visual": "node scripts/visual.mjs",
    "perf": "node scripts/perf.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "3.1156.0",
    "@aws-sdk/client-cloudtrail": "3.1156.0",
    "@aws-sdk/client-cloudwatch": "3.1156.0",
    "@aws-sdk/client-iam": "3.1156.0",
    "@aws-sdk/client-kms": "3.1156.0",
    "@aws-sdk/client-organizations": "3.1156.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-s3-control": "3.1156.0",
    "@aws-sdk/client-sts": "3.1156.0",
    "@aws-sdk/credential-provider-ini": "3.973.21",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "csv-parse": "7.0.3",
    "electron-updater": "6.8.11",
    "hyparquet": "1.31.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "^4.11.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "pixelmatch": "^7.1.0",
    "playwright-core": "1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.storageagent.app",
    "productName": "Storage Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-sign.cjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "node_modules/@earendil-works/pi-codemode/**",
      "node_modules/quickjs-wasi/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hxddh",
        "repo": "storage-agent-workbench"
      }
    ],
    "protocols": [
      {
        "name": "Storage Agent",
        "schemes": [
          "storage-agent"
        ]
      }
    ],
    "artifactName": "storage-agent-${version}-${os}-${arch}.${ext}"
  },
  "author": {
    "name": "Storage Agent",
    "email": "hxddh@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hxddh/storage-agent-workbench.git"
  },
  "desktopName": "storage-agent.desktop"
}
