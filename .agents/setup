#!/usr/bin/env bash
# Prepare a fresh orb for Storage Agent: Node dependencies and the Electron
# binary. Idempotent; safe to run again after a snapshot refresh.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }

step "Node"
if ! command -v npm >/dev/null 2>&1; then
  echo "npm is required but not on PATH" >&2
  exit 1
fi
node -e 'const major = Number(process.versions.node.split(".")[0]); if (major < 24) { console.error(`Node ${process.versions.node} is too old; 24+ is required`); process.exit(1) }'
node -v
npm -v

step "Dependencies"
if [ ! -d node_modules ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
  npm ci --no-audit --no-fund
else
  echo "    node_modules already matches package-lock.json"
fi

step "Electron"
if [ ! -x node_modules/.bin/electron ]; then
  npm install --no-audit --no-fund
fi
node -e 'console.log("    electron", require("electron/package.json").version)'

step "Checks"
npm run typecheck
echo "    typecheck ok"
