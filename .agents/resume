#!/usr/bin/env bash
# Fast wake check for Storage Agent. Never installs anything: it verifies the
# snapshot's toolchain and points at .agents/setup when it is stale.
set -euo pipefail

cd "$(dirname "$0")/.."
missing=()

if ! command -v node >/dev/null 2>&1; then
  missing+=("Node 24+ (run .agents/setup)")
else
  node -e 'const major = Number(process.versions.node.split(".")[0]); process.exit(major >= 24 ? 0 : 1)' \
    || missing+=("Node 24+ (run .agents/setup)")
fi

[ -d node_modules ] || missing+=("node_modules (run .agents/setup)")
[ -x node_modules/.bin/electron ] || missing+=("Electron binary (run .agents/setup)")

if [ "${#missing[@]}" -gt 0 ]; then
  printf 'Storage Agent is not ready:\n' >&2
  printf '  - %s\n' "${missing[@]}" >&2
  exit 1
fi

printf 'Storage Agent ready: Node %s, Electron, dependencies.\n' "$(node -v)"
